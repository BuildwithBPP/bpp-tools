---
import HQLayout from "../layouts/HQLayout.astro";
import DataState from "../components/DataState.astro";
import Section from "../components/Section.astro";
import SourceMeta from "../components/SourceMeta.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { pageCatalog, pagesRegistry } from "../data/registries";
import { departmentForPage, proposedDepartments } from "../data/page-routing.mjs";

const page = {
  title: "Library",
  description: "A registry-driven directory of authoritative, historical, draft, and archived BPP content.",
  owner: "Daunte",
  status: "live",
  source: pagesRegistry.source,
  verified: pagesRegistry.generated_at.slice(0, 10),
  freshnessDays: 7
};

const sections = [...new Set(pageCatalog.pages.map((record) => record.section))].sort();
const departments = proposedDepartments;
const owners = [...new Set(pageCatalog.pages.map((record) => record.owner))].sort();
const statuses = [...new Set(pageCatalog.pages.map((record) => record.status))].sort();
const migrations = [...new Set(pageCatalog.pages.map((record) => record.migration))].sort();
const confidentialities = [...new Set(pageCatalog.pages.map((record) => record.confidentiality))].sort();
const migrationCounts = Object.fromEntries(
  migrations.map((migration) => [migration, pageCatalog.pages.filter((record) => record.migration === migration).length])
);
const currentHubBase = "https://buildwithbpp.github.io/bpp-tools/";
---
<HQLayout {...page}>
  <header class="page-intro">
    <div class="page-intro-copy">
      <p class="eyebrow">Durable knowledge layer</p>
      <h1>Find the authoritative record</h1>
      <p>
        Library combines the governing registry with a reviewed inventory of every current
        and historical Hub page. Nothing disappears during migration, and old pages cannot
        quietly present themselves as the current answer.
      </p>
    </div>
    <SourceMeta
      owner={page.owner}
      status={page.status}
      source={page.source}
      verified={page.verified}
      freshnessDays={page.freshnessDays}
    />
  </header>

  <Section
    id="directory"
    eyebrow="Complete migration directory"
    title={`${pageCatalog.pages.length} Hub pages, one governed view`}
    description="Filters run locally. HQ section, department, owner, lifecycle, confidentiality, and migration are separate decisions. Current routing is proposed for owner review."
  >
    <div class="migration-summary" aria-label="Hub page migration summary">
      <article><strong>{migrationCounts["carry-forward"] ?? 0}</strong><span>Carry forward</span></article>
      <article><strong>{migrationCounts.historical ?? 0}</strong><span>Historical</span></article>
      <article><strong>{migrationCounts["retire-after-cutover"] ?? 0}</strong><span>Retire after cutover</span></article>
      <article><strong>{sections.length}</strong><span>HQ sections</span></article>
    </div>
    <form class="filter-bar" data-library-filters>
      <label>
        Search
        <input type="search" name="q" placeholder="Title, owner, source, or type" autocomplete="off" />
      </label>
      <label>
        HQ section
        <select name="section">
          <option value="">All sections</option>
          {sections.map((section) => <option value={section}>{section}</option>)}
        </select>
      </label>
      <label>
        Owner
        <select name="owner">
          <option value="">All owners</option>
          {owners.map((owner) => <option value={owner}>{owner}</option>)}
        </select>
      </label>
      <label>
        Lifecycle
        <select name="status">
          <option value="">All states</option>
          {statuses.map((status) => <option value={status}>{status}</option>)}
        </select>
      </label>
      <label>
        Department
        <select name="department">
          <option value="">All departments</option>
          {departments.map((department) => <option value={department}>{department}</option>)}
        </select>
      </label>
      <label>
        Migration
        <select name="migration">
          <option value="">All decisions</option>
          {migrations.map((migration) => <option value={migration}>{migration.replaceAll("-", " ")}</option>)}
        </select>
      </label>
      <label>
        Confidentiality
        <select name="confidentiality">
          <option value="">All classifications</option>
          {confidentialities.map((value) => <option value={value}>{value}</option>)}
        </select>
      </label>
    </form>

    <div class="table-wrap" role="region" aria-label="Library directory" tabindex="0">
      <table class="directory-table">
        <thead>
          <tr>
            <th>Record</th>
            <th>HQ section</th>
            <th>Proposed department</th>
            <th>Owner</th>
            <th>Status</th>
            <th>Migration</th>
            <th>Confidentiality</th>
            <th>Source page</th>
          </tr>
        </thead>
        <tbody data-library-rows>
          {pageCatalog.pages.map((record) => {
            const department = departmentForPage(record);
            return (
            <tr
              data-library-row
              data-catalog-id={record.id}
              data-title={record.title.toLowerCase()}
              data-description={record.description.toLowerCase()}
              data-section={record.section.toLowerCase()}
              data-department={department.toLowerCase()}
              data-owner={record.owner.toLowerCase()}
              data-status={record.status.toLowerCase()}
              data-migration={record.migration.toLowerCase()}
              data-confidentiality={record.confidentiality.toLowerCase()}
              data-source={record.source_path.toLowerCase()}
            >
              <td>
                <a
                  class="directory-title"
                  href={`${currentHubBase}${record.source_path}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{record.title}</span>
                  <span class="directory-title-note">Current Hub &#8599;</span>
                </a>
                <span class="directory-description">{record.description}</span>
              </td>
              <td>{record.section}</td>
              <td><span class="proposed-route">Proposed</span>{department}</td>
              <td>{record.owner}</td>
              <td><StatusBadge status={record.status} /></td>
              <td>{record.migration.replaceAll("-", " ")}</td>
              <td>{record.confidentiality}</td>
              <td class="directory-source">{record.source_path}</td>
            </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="library-empty" data-library-empty hidden>
      <DataState
        state="empty"
        title="No records match these filters"
        message="Clear one or more filters to return to the full registry directory."
      />
    </div>
    <SourceMeta
      owner="Daunte"
      status="live"
      source={pageCatalog.source}
      verified={pageCatalog.generated_at.slice(0, 10)}
      freshnessDays={30}
      compact
    />
  </Section>

  <Section
    eyebrow="Recently verified"
    title="Current registry set"
    description="Records are sorted and classified at the source. Historical content does not become stale merely because it is old."
  >
    <ul class="brief-list">
      {pagesRegistry.pages
        .toSorted((a, b) => b.last_verified.localeCompare(a.last_verified))
        .slice(0, 4)
        .map((record) => (
          <li class="brief-item">
            <strong>{record.owner}</strong>
            <p>{record.title} · verified {record.last_verified} · source: {record.source_of_truth}</p>
            <StatusBadge status={record.status} />
          </li>
        ))}
    </ul>
  </Section>

  <Section
    eyebrow="Migration rule"
    title="Carry forward before redesigning"
    description="Working tools remain available while their destination pages are built. Historical and retirement labels prevent duplicate answers from competing with current truth."
  >
    <div class="split-layout">
      <aside class="panel">
        <p class="panel-title">Carry forward</p>
        <p>Keep the working page reachable from HQ, then replace it only when a native route preserves its useful workflow and data.</p>
      </aside>
      <aside class="panel">
        <p class="panel-title">Retire after cutover</p>
        <p>Keep the source during transition. Retire it only after its canonical replacement is live, tested, linked, and approved.</p>
      </aside>
    </div>
    <DataState
      state="notice"
      title="Owner review is the next routing step"
      message="Use the Department and Migration filters to review the proposed assignments. Nothing is deleted by this list, and retire-after-cutover means keep until a tested replacement exists."
      source="72-file HTML review inventory"
    />
  </Section>

  <DataState
    state="notice"
    title="Legacy pages still open on the current Hub"
    message="The protected staging build now catalogs every Hub page and links to the working source. Moving those assets behind BPP HQ Access is a cutover step, not a reason to duplicate or prematurely rewrite them."
    source="BPP HQ migration catalog"
  />

  <script is:inline src="/scripts/library-filters.js" defer></script>
</HQLayout>
