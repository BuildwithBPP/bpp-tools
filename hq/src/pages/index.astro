---
import HQLayout from "../layouts/HQLayout.astro";
import ActionLink from "../components/ActionLink.astro";
import DataState from "../components/DataState.astro";
import Section from "../components/Section.astro";
import SourceMeta from "../components/SourceMeta.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { proofDate, proofDateLabel } from "../data/snapshot";

const page = {
  title: "Today",
  description: "The BPP owner brief for priorities, decisions, risks, and the current operating rhythm.",
  owner: "All owners",
  status: "live",
  source: "Current-week operating brief and BPP HQ master plan",
  verified: "2026-07-13",
  freshnessDays: 7
};
---
<HQLayout {...page}>
  <header class="page-intro">
    <div class="page-intro-copy">
      <p class="eyebrow">Owner brief / {proofDateLabel}</p>
      <h1>What matters now</h1>
      <p>
        A decision-ready snapshot for the three owners. Private staging separates verified
        business facts from proposed routing and information that needs a fresh system pull.
      </p>
    </div>
    <SourceMeta
      owner={page.owner}
      status={page.status}
      source={page.source}
      verified={page.verified}
      freshnessDays={page.freshnessDays}
    />
  </header>

  <Section
    eyebrow="Current focus"
    title="North star"
    description="The approved move for this implementation window."
  >
    <div class="north-star">
      <p class="eyebrow">Current implementation direction</p>
      <blockquote>
        Review every current HTML artifact, prove the protected HQ structure, and activate
        refreshes in staging before any production cutover.
      </blockquote>
    </div>
  </Section>

  <Section
    id="decisions"
    eyebrow="Owner attention"
    title="Decisions needed"
    description="These choices determine whether the proof of concept moves into migration."
  >
    <ul class="brief-list">
      <li class="brief-item">
        <strong>All owners</strong>
        <p>Review the 71-file inventory and correct proposed department, HQ section, and retirement decisions.</p>
        <StatusBadge status="needs review" />
      </li>
      <li class="brief-item">
        <strong>All owners</strong>
        <p>Complete Kenny and Eli's protected staging acceptance before production planning.</p>
        <StatusBadge status="needs review" />
      </li>
      <li class="brief-item">
        <strong>Daunte</strong>
        <p>Authorize Monday.com next so Delivery can replace its July 24 static fallback with governed live data.</p>
        <StatusBadge status="in progress" />
      </li>
    </ul>
    <SourceMeta
      owner="All owners"
      status="proposed"
      source="BPP HQ master plan, owner meeting decisions"
      verified={proofDate}
      freshnessDays={7}
      compact
    />
  </Section>

  <Section
    id="commitments"
    eyebrow="Ownership"
    title="Owner commitments"
    description="The approved review lanes keep the decision clear without duplicating department pages."
  >
    <div class="split-layout">
      <ul class="brief-list">
        <li class="brief-item">
          <strong>Daunte</strong>
          <p>Technical architecture, data governance, protection, and implementation evidence.</p>
          <StatusBadge status="current" />
        </li>
        <li class="brief-item">
          <strong>Kenny</strong>
          <p>Growth structure, seller workflow, ICP fit, and offer consistency.</p>
          <StatusBadge status="current" />
        </li>
        <li class="brief-item">
          <strong>Eli</strong>
          <p>Visual direction, usability, Delivery experience, and future client translation.</p>
          <StatusBadge status="current" />
        </li>
      </ul>
      <aside class="panel">
        <p class="panel-title">Shared acceptance</p>
        <p>
          All three owners approve the name, information architecture, public/private boundary,
          proof-of-concept acceptance, and cutover.
        </p>
        <StatusBadge status="needs review" />
      </aside>
    </div>
    <SourceMeta
      owner="All owners"
      status="canonical"
      source="BPP HQ master plan, owner review and governance"
      verified={proofDate}
      freshnessDays={30}
      compact
    />
  </Section>

  <Section
    id="risks"
    eyebrow="Operating risk"
    title="What needs confirmation"
    description="Unknown state is visible here instead of being presented as current."
  >
    <div class="stack-list">
      <DataState
        state="stale"
        title="Current-week operating brief is stale"
        message="The last repository brief was generated July 13. Client, pipeline, and owner-priority details need a fresh source pull before the team treats them as today's operating truth."
        source="data/monday-prep-latest.json"
      />
      <DataState
        state="notice"
        title="Protected preview access is verified"
        message="The staging site requires Microsoft Entra sign-in and uses the exact three-owner Access allowlist. A live denied-identity observation and the external credential evidence remain separate follow-up checks."
        source="BPP HQ protected preview deployment record"
      />
      <DataState
        state="notice"
        title="Connector coverage is partial"
        message="HubSpot refresh and its governed BI summary are live in protected staging. Monday.com, QuickBooks, GitHub/Workspace, and Metricool still require provider authorization or an approved bridge."
        source="BPP HQ Data Refresh Center, verified August 1"
      />
    </div>
  </Section>

  <Section
    eyebrow="Owner review"
    title="Current agenda"
    description="A focused review sequence for deciding whether the replacement architecture is ready."
  >
    <ol class="agenda plain-list">
      <li><span>Filter the 71-file Library by proposed department.</span><time>15 min</time></li>
      <li><span>Mark pages to keep, move, preserve as history, or retire after cutover.</span><time>20 min</time></li>
      <li><span>Review the six department cockpit structures.</span><time>10 min</time></li>
      <li><span>Confirm Monday.com as the next connector and QuickBooks as the financial authority.</span><time>15 min</time></li>
    </ol>
    <SourceMeta
      owner="Daunte"
      status="proposed"
      source="Proof-of-concept review sequence"
      verified={proofDate}
      freshnessDays={7}
      compact
    />
  </Section>

  <Section
    eyebrow="Next moves"
    title="Open the operating view you need"
    description="Each action leads to a working route in this proof of concept."
  >
    <div class="action-grid">
      <ActionLink
        href="/performance/"
        eyebrow="BI view"
        title="Review performance"
        description="Read actuals against the Business Plan target and inspect the current data-quality notes."
        meta="Owner: Daunte"
      />
      <ActionLink
        href="/company/"
        eyebrow="Plan of Record"
        title="Read company direction"
        description="Review strategy, ownership, operating cadence, and the superseded plan notice."
        meta="Owner: All owners"
      />
      <ActionLink
        href="/library/"
        eyebrow="Authoritative content"
        title="Search the Library"
        description="Filter registry-backed content by owner, lifecycle, and confidentiality."
        meta="Owner: Daunte"
      />
    </div>
  </Section>
</HQLayout>
