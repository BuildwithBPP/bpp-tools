---
import HQLayout from "../layouts/HQLayout.astro";
import Metric from "../components/Metric.astro";
import Section from "../components/Section.astro";
import SourceMeta from "../components/SourceMeta.astro";
import CheckpointHero from "../components/delivery/CheckpointHero.astro";
import ControlGapList from "../components/delivery/ControlGapList.astro";
import DeliveryNav from "../components/delivery/DeliveryNav.astro";
import SyncState from "../components/delivery/SyncState.astro";
import TaskCard from "../components/delivery/TaskCard.astro";
import { deliveryCommand } from "../data/delivery-command";
import { assessCheckpoint, calculateKpis, findControlGaps, rankPullForwardTasks } from "../domain/delivery/control";
import { appPath } from "../lib/app-path";

const today = "2026-08-27";
const page = {
  title: "Delivery Today",
  description: "Eli's client delivery command center for today's work, upcoming checkpoints, and control gaps.",
  owner: "Eli Fisher",
  status: "live",
  source: `Monday Client Delivery board ${deliveryCommand.source.boardId}`,
  verified: deliveryCommand.source.sourceUpdatedAt.slice(0, 10),
  freshnessDays: 2
};
const upcoming = deliveryCommand.checkpoints
  .filter((checkpoint) => checkpoint.plannedDate && checkpoint.plannedDate >= today)
  .sort((a, b) => (a.plannedDate ?? "").localeCompare(b.plannedDate ?? ""));
const nextCheckpoint = upcoming[0];
const nextAssessment = assessCheckpoint(deliveryCommand, nextCheckpoint.id, today);
const nextProject = deliveryCommand.projects.find((project) => project.id === nextCheckpoint.projectId)!;
const nextTasks = nextCheckpoint.requiredTaskIds
  .map((id) => deliveryCommand.tasks.find((task) => task.id === id))
  .filter((task): task is NonNullable<typeof task> => task !== undefined);
const pullForward = rankPullForwardTasks(deliveryCommand, today).slice(0, 5);
const gaps = findControlGaps(deliveryCommand);
const kpis = calculateKpis(deliveryCommand, today);
const priorityThreats = deliveryCommand.raid.filter((item) => item.status !== "closed").sort((a, b) => Number(b.impact === "high") - Number(a.impact === "high")).slice(0, 4);
const projectFor = (id: string) => deliveryCommand.projects.find((project) => project.id === id)!;
---
<HQLayout {...page}>
  <header class="page-intro delivery-intro">
    <div class="page-intro-copy">
      <p class="eyebrow">Client delivery command center</p>
      <h1>What needs to move today</h1>
      <p>One operating view for work, meeting readiness, and the gaps that could put delivery behind.</p>
    </div>
    <SyncState state="snapshot" sourceUpdatedAt={deliveryCommand.source.sourceUpdatedAt} />
  </header>
  <DeliveryNav />

  <div class="delivery-kpi-strip" aria-label="Delivery key performance indicators">
    <Metric label="Due next 7 days" value={String(kpis.dueNextSevenDays)} comparison="Dated open actions" timeframe="Aug 27 to Sep 3" source="Monday subitems" />
    <Metric label="Blocked" value={String(kpis.blocked)} comparison="Needs intervention" timeframe="Current snapshot" source="Monday task status" tone={kpis.blocked ? "negative" : "positive"} />
    <Metric label="Awaiting client" value={String(kpis.awaitingClient)} comparison="Inputs outside Eli's control" timeframe="Current snapshot" source="Monday client actions" tone="warning" />
    <Metric label="Control gaps" value={String(kpis.missingControlData)} comparison="Missing owner, date, breakdown, meeting, or evidence" timeframe="Current snapshot" source="Derived control audit" tone="warning" />
  </div>

  <CheckpointHero checkpoint={nextCheckpoint} assessment={nextAssessment} project={nextProject} tasks={nextTasks} />

  <div class="delivery-two-column">
    <Section eyebrow="Lock in" title="Best work to pull forward" description="Ranked by priority and latest-safe date. Capacity hours are not inferred.">
      <div class="task-stack">
        {pullForward.map((task) => <TaskCard task={task} project={projectFor(task.projectId)} />)}
      </div>
      <a class="section-link" href={appPath("/delivery/week/")}>Open the full week</a>
    </Section>
    <Section eyebrow="Threat radar" title="What could break the plan" description="Open risks, issues, and dependencies tied to the two website builds.">
      <div class="threat-list">
        {priorityThreats.map((item) => (
          <article>
            <span class={`gap-kind gap-${item.type}`}>{item.type}</span>
            <div><strong>{item.title}</strong><p>{item.response}</p></div>
            <a href={item.sourceUrl} target="_blank" rel="noreferrer">Source</a>
          </article>
        ))}
      </div>
      <a class="section-link" href={appPath("/delivery/raid/")}>Open the RAID log</a>
    </Section>
  </div>

  <Section eyebrow="Poka-yoke" title="Control gaps to close" description="The dashboard shows missing control data instead of filling it with assumptions.">
    <ControlGapList gaps={gaps} projects={deliveryCommand.projects} />
  </Section>
  <SourceMeta owner={page.owner} status={page.status} source={page.source} verified={page.verified} freshnessDays={page.freshnessDays} />
</HQLayout>
