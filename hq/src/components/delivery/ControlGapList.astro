---
import type { ControlGap, DeliveryProject } from "../../domain/delivery/types";
import { appPath } from "../../lib/app-path";
interface Props { gaps: ControlGap[]; projects: DeliveryProject[]; limit?: number; }
const { gaps, projects, limit = 6 } = Astro.props;
const shown = gaps.slice(0, limit);
const projectName = (id: string) => projects.find((project) => project.id === id)?.name ?? id;
---
<div class="control-gap-list">
  {shown.length === 0 ? (
    <p class="empty-state">No control gaps in this view.</p>
  ) : shown.map((gap) => (
    <article class="control-gap">
      <span class={`gap-kind gap-${gap.kind}`}>{gap.kind}</span>
      <div>
        <strong>{gap.message}</strong>
        <span>{projectName(gap.projectId)}</span>
      </div>
      {gap.mondayUrl && <a href={gap.mondayUrl} target="_blank" rel="noreferrer">Fix in Monday</a>}
    </article>
  ))}
  {gaps.length > limit && <a class="control-gap-more" href={appPath("/delivery/projects/")}>View {gaps.length - limit} more gaps</a>}
</div>
