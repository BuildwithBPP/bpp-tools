---
import { appPath } from "../../lib/app-path";

const links = [
  { href: appPath("/delivery/"), label: "Today" },
  { href: appPath("/delivery/week/"), label: "Week" },
  { href: appPath("/delivery/timeline/"), label: "Timeline" },
  { href: appPath("/delivery/projects/"), label: "Projects" },
  { href: appPath("/delivery/raid/"), label: "RAID" }
];
const currentPath = Astro.url.pathname;
---
<nav class="delivery-nav" aria-label="Client delivery views">
  <span class="delivery-nav-label">Control views</span>
  <div class="delivery-nav-links">
    {links.map((link) => (
      <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>
    ))}
  </div>
</nav>
