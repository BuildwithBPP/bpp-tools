---
interface Point {
  label: string;
  value: number;
}

interface Props {
  points: Point[];
  title: string;
  description: string;
}

const { points, title, description } = Astro.props;
const width = 980;
const height = 300;
const plot = { left: 68, right: 24, top: 34, bottom: 54 };
const plotWidth = width - plot.left - plot.right;
const plotHeight = height - plot.top - plot.bottom;
const rawMax = Math.max(...points.map((point) => point.value), 1);
const tickStep = rawMax <= 3000 ? 1000 : Math.ceil(rawMax / 3 / 1000) * 1000;
const axisMax = Math.ceil(rawMax / tickStep) * tickStep;
const ticks = Array.from({ length: Math.floor(axisMax / tickStep) + 1 }, (_, index) => index * tickStep);
const slot = plotWidth / points.length;
const barWidth = Math.min(64, slot * 0.56);
const compactMoney = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  notation: "compact",
  maximumFractionDigits: 1
});
---
<figure class="chart-figure" role="region" aria-label={title} tabindex="0">
  <svg
    class="trend-chart"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="revenue-trend-title revenue-trend-description"
  >
    <title id="revenue-trend-title">{title}</title>
    <desc id="revenue-trend-description">{description}</desc>
    <defs>
      <linearGradient id="revenue-bar-gradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0874a6" />
        <stop offset="1" stop-color="#044771" />
      </linearGradient>
    </defs>

    {ticks.map((tick) => {
      const y = plot.top + plotHeight - (tick / axisMax) * plotHeight;
      return (
        <g class="chart-gridline">
          <line x1={plot.left} x2={width - plot.right} y1={y} y2={y} />
          <text x={plot.left - 12} y={y + 4} text-anchor="end">{compactMoney.format(tick)}</text>
        </g>
      );
    })}

    {points.map((point, index) => {
      const barHeight = Math.max(3, (point.value / axisMax) * plotHeight);
      const x = plot.left + index * slot + (slot - barWidth) / 2;
      const y = plot.top + plotHeight - barHeight;
      const center = x + barWidth / 2;
      return (
        <g class="chart-column">
          <rect x={x} y={y} width={barWidth} height={barHeight} rx="2" fill="url(#revenue-bar-gradient)" />
          <line class="chart-column-cap" x1={x} x2={x + barWidth} y1={y} y2={y} />
          <text class="chart-value" x={center} y={Math.max(17, y - 10)} text-anchor="middle">
            {compactMoney.format(point.value)}
          </text>
          <text class="chart-label" x={center} y={height - 21} text-anchor="middle">{point.label}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>{description}</figcaption>
</figure>
