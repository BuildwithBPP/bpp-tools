---
import StatusBadge from "./StatusBadge.astro";

interface Props {
  label: string;
  value: string;
  timeframe: string;
  source: string;
  comparison?: string;
  tone?: "default" | "positive" | "warning" | "negative";
  status?: string;
  liveHubSpotMetric?: "open_pipeline_amount" | "hot_deal_count";
}

const {
  label,
  value,
  timeframe,
  source,
  comparison,
  tone = "default",
  status,
  liveHubSpotMetric
} = Astro.props;
---
<article class:list={["metric", `metric-${tone}`]} data-live-hubspot-metric={liveHubSpotMetric}>
  <div class="metric-heading">
    <p>{label}</p>
    {status && <StatusBadge status={status} />}
  </div>
  <p class="metric-value" data-live-value>{value}</p>
  {comparison && <p class="metric-comparison" data-live-comparison>{comparison}</p>}
  <dl class="metric-context">
    <div>
      <dt>Timeframe</dt>
      <dd data-live-timeframe>{timeframe}</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd data-live-source>{source}</dd>
    </div>
  </dl>
</article>
