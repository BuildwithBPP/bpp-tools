---
import StatusBadge from "./StatusBadge.astro";

interface Props {
  label: string;
  value: string;
  timeframe: string;
  source: string;
  comparison?: string;
  tone?: "default" | "positive" | "warning" | "negative";
  status?: string;
  liveHubSpotMetric?: "open_pipeline_amount" | "hot_deal_count";
  liveMondayMetric?: "tracked_client_count" | "open_deliverable_count" | "overdue_work_count";
  liveQuickBooksMetric?: "revenue_ytd" | "net_income_ytd" | "cash_available";
  livePlanTarget?: number;
  liveBufferTarget?: number;
}

const {
  label,
  value,
  timeframe,
  source,
  comparison,
  tone = "default",
  status,
  liveHubSpotMetric,
  liveMondayMetric,
  liveQuickBooksMetric,
  livePlanTarget,
  liveBufferTarget
} = Astro.props;
---
<article
  class:list={["metric", `metric-${tone}`]}
  data-live-hubspot-metric={liveHubSpotMetric}
  data-live-monday-metric={liveMondayMetric}
  data-live-quickbooks-metric={liveQuickBooksMetric}
  data-live-plan-target={livePlanTarget}
  data-live-buffer-target={liveBufferTarget}
>
  <div class="metric-heading">
    <p>{label}</p>
    {status && <StatusBadge status={status} />}
  </div>
  <p class="metric-value" data-live-value>{value}</p>
  {comparison && <p class="metric-comparison" data-live-comparison>{comparison}</p>}
  <dl class="metric-context">
    <div>
      <dt>Timeframe</dt>
      <dd data-live-timeframe>{timeframe}</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd data-live-source>{source}</dd>
    </div>
  </dl>
</article>
