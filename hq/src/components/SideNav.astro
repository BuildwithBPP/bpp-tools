---
interface Props {
  currentPath: string;
  mobile?: boolean;
}

const { currentPath, mobile = false } = Astro.props;
const links = [
  { href: "/", label: "Today", key: "01" },
  { href: "/performance/", label: "Performance", key: "02" },
  { href: "/growth/", label: "Growth", key: "03" },
  { href: "/delivery/", label: "Delivery", key: "04" },
  { href: "/company/", label: "Company", key: "05" },
  { href: "/library/", label: "Library", key: "06" }
];

function isCurrent(href: string) {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---
<nav class:list={["primary-nav", { "primary-nav-mobile": mobile }]} aria-label="BPP HQ">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          <span class="nav-key" aria-hidden="true">{link.key}</span>
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
