---
interface Props {
  currentPath: string;
  mobile?: boolean;
}

import { appPath } from "../lib/app-path";

const { currentPath, mobile = false } = Astro.props;
const links = [
  { href: appPath("/"), label: "Today", key: "01" },
  { href: appPath("/performance/"), label: "Performance", key: "02" },
  { href: appPath("/growth/"), label: "Growth", key: "03" },
  { href: appPath("/delivery/"), label: "Delivery", key: "04" },
  { href: appPath("/company/"), label: "Company", key: "05" },
  { href: appPath("/library/"), label: "Library", key: "06" }
];

function isCurrent(href: string) {
  return href === appPath("/") ? currentPath === appPath("/") : currentPath.startsWith(href);
}
---
<nav class:list={["primary-nav", { "primary-nav-mobile": mobile }]} aria-label="BPP HQ">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          <span class="nav-key" aria-hidden="true">{link.key}</span>
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
