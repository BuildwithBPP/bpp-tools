{
  "name": "bpp-hq-proof-of-concept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:delivery-api": "node scripts/delivery-dev-api.mjs",
    "dev:delivery": "PUBLIC_DELIVERY_API_URL=http://127.0.0.1:8788 astro dev",
    "delivery:refresh": "node scripts/build-delivery-snapshot.mjs",
    "delivery:check": "node scripts/build-delivery-snapshot.mjs --check",
    "build": "astro check && astro build",
    "build:legacy": "astro check && HQ_PUBLIC_BASE=/bpp-tools/bpp-hq HQ_PUBLIC_OUT_DIR=../bpp-hq astro build && HQ_DIST_ROOT=../bpp-hq HQ_PUBLIC_BASE=/bpp-tools/bpp-hq node scripts/validate.mjs",
    "preview": "astro preview",
    "test:unit": "node --test src/domain/delivery/*.test.ts src/lib/*.test.ts scripts/*.test.mjs",
    "test": "npm run test:unit && npm run build && node scripts/validate.mjs",
    "validate": "node scripts/validate.mjs",
    "screenshots": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.1.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^26.3.0",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2"
  }
}
