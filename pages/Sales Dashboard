<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BPP Contact Outreach Directory</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #f6f7fb; --card: #ffffff; --ink: #0f172a; --muted: #64748b; --border: #e5e9f0;
    --navy: #1e2a4a; --accent: #3b5bdb;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, Arial, sans-serif; background: var(--bg); color: var(--ink); }
  header.top { background: linear-gradient(135deg, #1e2a4a 0%, #2d3f6e 100%); color:#fff; padding: 32px 40px 28px; }
  header.top h1 { margin:0 0 4px; font-size: 26px; font-weight: 700; letter-spacing: -0.3px; }
  header.top p { margin:0; color:#c7d0e8; font-size: 14px; }
  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  .stats-row { display:grid; grid-template-columns: repeat(7, 1fr); gap: 12px; margin: -20px 0 28px; }
  .stat-card { background: var(--card); border-radius: 12px; padding: 16px 14px; text-decoration:none; color: inherit;
    box-shadow: 0 1px 3px rgba(15,23,42,0.08); border-top: 3px solid var(--ac); transition: transform .12s ease; }
  a.stat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(15,23,42,0.12); }
  .stat-num { font-size: 26px; font-weight: 800; color: var(--ac); line-height:1; }
  .stat-label { font-size: 11.5px; color: var(--muted); margin-top: 6px; font-weight:600; text-transform: uppercase; letter-spacing:.3px;}

  .panels { display:grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin-bottom: 16px; }
  .panel { background: var(--card); border-radius: 12px; padding: 20px 22px; box-shadow: 0 1px 3px rgba(15,23,42,0.06); border: 1px solid var(--border); }
  .panel h3 { margin: 0 0 12px; font-size: 15px; color: var(--navy); }
  .panel table { width:100%; border-collapse: collapse; font-size: 13px; }
  .panel td { padding: 6px 4px; border-bottom: 1px solid #f0f2f7; vertical-align: top; }
  .panel td.num { font-weight:700; color: var(--accent); width: 30px; }
  .panel td.r { text-align:right; font-weight:700; }
  .panel td.small { color: var(--muted); font-size:12px; }
  .panel ul { margin: 4px 0 0; padding-left: 18px; font-size: 13px; line-height: 1.65; }
  .callout { background:#f8f9fe; border-radius:10px; padding:12px 14px; margin-bottom:10px; font-size:13px; line-height:1.6; }
  .callout b { color: var(--navy); }

  nav.stickynav { position: sticky; top:0; z-index: 10; background: rgba(246,247,251,0.95); backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border); padding: 10px 0; margin-bottom: 24px; overflow-x:auto; white-space:nowrap; }
  .navlink { display:inline-block; padding: 7px 14px; margin-right:6px; border-radius: 20px; background:#fff; border:1px solid var(--border);
    color: var(--navy); text-decoration:none; font-size:13px; font-weight:600; }
  .navlink:hover { border-color: var(--accent); color: var(--accent); }
  .navcount { color: var(--muted); font-weight:500; }

  section.section { margin-bottom: 40px; scroll-margin-top: 66px; }
  .section-head h2 { font-size: 19px; margin: 0 0 4px; color: var(--navy); }
  .count-badge { background:#eef1f9; color:var(--accent); font-size:13px; padding:2px 10px; border-radius:12px; font-weight:700; vertical-align:middle;}
  .count-badge.sm { font-size:11px; padding:1px 8px; }
  .section-desc { color: var(--muted); font-size: 13px; margin: 0 0 12px; }
  .search-box { width: 100%; max-width: 340px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border); font-size: 13px; margin-bottom: 12px; }

  .subbatch { margin-bottom: 22px; }
  .subbatch h3 { font-size: 14.5px; color: var(--navy); margin: 0 0 8px; }

  .table-wrap { background: var(--card); border-radius: 12px; border: 1px solid var(--border); overflow: auto; box-shadow: 0 1px 3px rgba(15,23,42,0.05); }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  thead th { text-align: left; background: #f8f9fc; color: var(--muted); font-size: 11.5px; text-transform: uppercase;
    letter-spacing: .4px; padding: 10px 14px; border-bottom: 1px solid var(--border); position: sticky; top: 0; }
  .dl th.r, .dl td.r { text-align:right; }
  tbody td { padding: 10px 14px; border-bottom: 1px solid #f1f3f8; vertical-align: top; }
  tbody tr:hover { background: #fafbff; }
  tbody tr:last-child td { border-bottom: none; }
  .cname { font-weight: 600; }
  .csub { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .csub a { color: var(--muted); text-decoration: none; }
  .csub a:hover { text-decoration: underline; }

  .pill { display:inline-block; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;
    background: color-mix(in srgb, var(--pc) 15%, white); color: color-mix(in srgb, var(--pc) 70%, black); }
  .pill2 { display:inline-block; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:700; background:#e4eef7; color:var(--navy); }
  .flag { display:inline-block; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:700; margin-right:4px; }
  .flag-warn { background:#fef3c7; color:#92400e; }
  .flag-ok { background:#d1fae5; color:#065f46; }
  .flag-noowner { background:#fee2e2; color:#991b1b; }
  .star { color:#f59e0b; }

  .minichart { display:flex; align-items:flex-end; gap:6px; height:140px; padding-top:10px; }
  .mcol { flex:1; display:flex; flex-direction:column; align-items:center; }
  .mbars { display:flex; align-items:flex-end; gap:2px; height:110px; width:100%; justify-content:center; }
  .mbar { width:8px; border-radius:2px 2px 0 0; }
  .mbar.won { background:#10b981; } .mbar.lost { background:#cbd5e1; }
  .mlabel { font-size:9.5px; color:var(--muted); margin-top:4px; }
  .legend { display:flex; gap:14px; margin-top:10px; font-size:12px; color:var(--muted); }
  .legend i { display:inline-block; width:9px; height:9px; border-radius:2px; margin-right:5px; vertical-align:middle; }

  .ob-table { font-size:13px; }
  .ob-table th { text-align:center; }
  .ob-table td.num { text-align:center; }

  footer { text-align:center; color: var(--muted); font-size: 12px; padding: 30px 0 50px; }

  @media (max-width: 1000px) {
    .stats-row { grid-template-columns: repeat(3,1fr); }
    .panels { grid-template-columns: 1fr; }
  }
</style>
</head>
